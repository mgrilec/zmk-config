#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt { quick-tap-ms = <200>; };

/ {
    combos {
        compatible = "zmk,combos";

        // Combo reset behaviors run on the central (the dongle).
        // Use the still-connected half after one second without typing.
        dongle_reset_left {
            timeout-ms = <100>;
            require-prior-idle-ms = <1000>;
            key-positions = <1 2 3 4>; // Q W E R
            bindings = <&sys_reset>;
        };

        dongle_reset_right {
            timeout-ms = <100>;
            require-prior-idle-ms = <1000>;
            key-positions = <7 8 9 10>; // U I O P
            bindings = <&sys_reset>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri-layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        zh: zh {
            compatible = "zmk,behavior-tap-dance";
            label = "ZH";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp BACKSLASH>;
        };

        dot: dot {
            compatible = "zmk,behavior-tap-dance";
            label = "DOT";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp LS(DOT)>, <&kp LS(MINUS)>;
        };

        comma: comma {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMA";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(COMMA)>, <&kp LS(NUMBER_1)>;
        };

        sh: sh {
            compatible = "zmk,behavior-tap-dance";
            label = "SH";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LEFT_BRACKET>;
        };

        dzh: dzh {
            compatible = "zmk,behavior-tap-dance";
            label = "DZH";
            #binding-cells = <0>;
            bindings = <&kp C_VOLUME_UP>, <&kp RIGHT_BRACKET>;
        };

        chh: chh {
            compatible = "zmk,behavior-tap-dance";
            label = "CHH";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp SEMICOLON>;
        };

        cch: cch {
            compatible = "zmk,behavior-tap-dance";
            label = "CCH";
            #binding-cells = <0>;
            bindings = <&kp C_VOLUME_DOWN>, <&kp SINGLE_QUOTE>;
        };

        kp_dot_comma: kp_dot_comma {
            compatible = "zmk,behavior-tap-dance";
            label = "KP_DOT_COMMA";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp KP_DOT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&mt LGUI ESCAPE      &kp Q  &kp W  &kp E            &kp R            &kp T      &kp Y        &kp U                      &kp I      &kp O  &kp P  &zh
&mt LCTRL TAB        &kp A  &kp S  &kp D            &kp F            &kp G      &kp H        &kp J                      &kp K      &kp L  &sh    &dzh
&mt RIGHT_ALT TILDE  &kp Z  &kp X  &kp C            &kp V            &kp B      &kp N        &kp M                      &comma     &dot   &chh   &cch
                                   &lt 2 BACKSPACE  &mt LSHFT SPACE  &lt 1 RET  &lt 1 ENTER  &mt RIGHT_SHIFT BACKSPACE  &lt 2 DEL
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
&trans  &kp KP_SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9        &kp KP_MINUS   &kp PAGE_UP    &kp HOME  &kp UP_ARROW    &kp END    &kp LS(N8)  &kp LS(N9)
&trans  &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6        &kp KP_PLUS    &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp RA(F)   &kp RA(G)
&trans  &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3        &kp_dot_comma  &trans         &trans    &trans          &trans     &kp RA(B)   &kp RA(N)
                                    &trans     &kp KP_NUMBER_0  &trans         &trans         &trans    &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&mt LGUI F1     &kp F2    &kp F3  &kp F4    &kp F5    &kp F6     &kp F7     &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&mt LCTRL PLUS  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &mt RCTRL MINUS
&mt LALT EQUAL  &kp N1    &kp N2  &kp N3    &kp N4    &kp N5     &kp N6     &kp N7    &kp N8    &kp N9    &kp N0    &kp RALT
                                  &trans    &trans    &trans     &trans     &trans    &trans
            >;
        };

        adjust_layer {
            display-name = "ADJ";
            bindings = <
&bootloader  &studio_unlock  &none         &none         &none         &none         &none         &none         &none         &none         &studio_unlock  &bootloader
&bt BT_CLR   &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0    &bt BT_CLR
&sys_reset   &none           &none         &none         &none         &none         &none         &none         &none         &none         &none           &sys_reset
                                           &trans        &none         &trans        &none         &trans        &trans
            >;
        };
    };
};
